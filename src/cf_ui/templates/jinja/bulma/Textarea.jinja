{#def name, label, value="", error="", rows=4, extra_class="", input_class="", attrs={} #}
{% autoescape true %}
  {% set attrs = attrs if attrs is defined else {} %}
  <div class="field {{ extra_class }}">
    <label class="label" for="{{ name }}">{{ label }}</label>
    <div class="control">
      <textarea
        class="textarea{% if error %} is-danger{% endif %}{% if input_class %} {{ input_class }}{% endif %}"
        id="{{ name }}"
        name="{{ name }}"
        rows="{{ rows }}"
        {{- cf_ui_render_attrs("textarea", attrs) }}
      >{{ value }}</textarea>
    </div>
    {% if error %}<p class="help is-danger">{{ error }}</p>{% endif %}
  </div>
{% endautoescape %}
