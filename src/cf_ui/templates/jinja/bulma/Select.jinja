{#def name, label, value="", error="", options=[], extra_class="", input_class="", attrs={} #}
{% autoescape true %}
  {% set attrs = attrs if attrs is defined else {} %}
  <div class="field {{ extra_class }}">
    <label class="label" for="{{ name }}">{{ label }}</label>
    <div class="control">
      <div class="select{% if error %} is-danger{% endif %} is-fullwidth">
        <select
          id="{{ name }}"
          name="{{ name }}"
          {% if input_class %} class="{{ input_class }}"{% endif %}
          {{- cf_ui_render_attrs("select", attrs) }}
        >
          {% for opt in options %}
            <option
              value="{{ opt.value }}"
              {% if opt.value|string == value|string %} selected{% endif %}
            >{{ opt.label }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
    {% if error %}<p class="help is-danger">{{ error }}</p>{% endif %}
  </div>
{% endautoescape %}
