{#def content="", level="2", size="normal", emphasis="normal", extra_class="" #}
{% autoescape true %}
  {% set content = content if content is defined else "" %}
  {% set level = level if level is defined else "2" %}
  {% set size = size if size is defined else "normal" %}
  {% set emphasis = emphasis if emphasis is defined else "normal" %}
  {% set extra_class = extra_class if extra_class is defined else "" %}
  {{ cf_ui_validate("heading", level=level, size=size, emphasis=emphasis) }}
  <h{{ level }} class="{% if size == 'small' %}h6{% elif size == 'normal' %}h4{% elif size == 'large' %}h1{% endif %}{% if emphasis == 'subtle' %} text-body-secondary{% endif %}{% if extra_class %} {{ extra_class }}{% endif %}">{{ content }}</h{{ level }}>
{% endautoescape %}
