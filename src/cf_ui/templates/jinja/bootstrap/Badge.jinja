{#def content="", variant="neutral", size="normal", extra_class="" #}
{% autoescape true %}
{% set content = content if content is defined else "" %}
{% set variant = variant if variant is defined else "neutral" %}
{% set size = size if size is defined else "normal" %}
{% set extra_class = extra_class if extra_class is defined else "" %}
{{- cf_ui_validate("badge", variant=variant, size=size) -}}
<span class="badge{% if variant == 'primary' %} text-bg-primary{% elif variant == 'secondary' %} text-bg-secondary{% elif variant == 'success' %} text-bg-success{% elif variant == 'warning' %} text-bg-warning{% elif variant == 'danger' %} text-bg-danger{% elif variant == 'info' %} text-bg-info{% elif variant == 'neutral' %} text-bg-light{% endif %}{% if extra_class %} {{ extra_class }}{% endif %}">{{ content }}</span>
{% endautoescape %}
