{#def name, label, value="", error="", rows=4, extra_class="", input_class="" #}
{% autoescape true %}
  {% set value = value if value is defined else "" %}
  {% set error = error if error is defined else "" %}
  {% set rows = rows if rows is defined else 4 %}
  {% set extra_class = extra_class if extra_class is defined else "" %}
  {% set input_class = input_class if input_class is defined else "" %}
  <div class="mb-3 {{ extra_class }}">
    <label class="form-label" for="{{ name }}">{{ label }}</label>
    <textarea
      class="form-control{% if error %} is-invalid{% endif %}{% if input_class %} {{ input_class }}{% endif %}"
      id="{{ name }}"
      name="{{ name }}"
      rows="{{ rows }}"
    >{{ value }}</textarea>
    {% if error %}<div class="invalid-feedback d-block">{{ error }}</div>{% endif %}
  </div>
{% endautoescape %}
