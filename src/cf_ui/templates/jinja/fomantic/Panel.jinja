{#def title, id="panel", content="", open=false, extra_class="" #}
{% autoescape true %}
{% set content = content if content is defined else "" %}
{% set id = id if id is defined else "panel" %}
{% set open = open if open is defined else false %}
{% set extra_class = extra_class if extra_class is defined else "" %}
{# `.ui.accordion .title ~ .content:not(.active)` is `display:none`, so the open
   state has to be a *class*, not only `x-show`: Alpine dropping its inline
   `display:none` would leave the stylesheet's rule in force. Both are bound so
   the panel is right with Alpine off (class, server-rendered) and with it on. #}
<div class="ui styled fluid accordion {{ extra_class }}"
     x-data="cfPanel"
     x-init="initPanel()"
     data-cf-open="{% if open %}true{% else %}false{% endif %}">
  <button type="button"
          class="title{% if open %} active{% endif %}"
          :class="{ 'active': open }"
          aria-controls="{{ id }}-body"
          aria-expanded="{% if open %}true{% else %}false{% endif %}"
          :aria-expanded="open"
          @click="toggle()">
    <span class="dropdown icon" aria-hidden="true">&#9654;</span>{{ title }}
  </button>
  <div id="{{ id }}-body"
       class="content{% if open %} active{% endif %}"
       :class="{ 'active': open }"
       x-show="open"
       {% if not open %}x-cloak{% endif %}>
    {{ content }}
  </div>
</div>
{% endautoescape %}
