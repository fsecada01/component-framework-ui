{#def content="", variant="neutral", size="normal", extra_class="" #}
{% autoescape true %}
  {% set content = content if content is defined else "" %}
  {% set variant = variant if variant is defined else "neutral" %}
  {% set size = size if size is defined else "normal" %}
  {% set extra_class = extra_class if extra_class is defined else "" %}
  {{- cf_ui_validate("badge", variant=variant, size=size) -}}
  <span
    class="ui label{% if variant == 'primary' %} primary{% elif variant == 'secondary' %} secondary{% elif variant == 'success' %} green{% elif variant == 'warning' %} yellow{% elif variant == 'danger' %} red{% elif variant == 'info' %} teal{% endif %}{% if size == 'small' %} small{% elif size == 'large' %} large{% endif %}{% if extra_class %} {{ extra_class }}{% endif %}"
  >{{ content }}</span>
{% endautoescape %}
