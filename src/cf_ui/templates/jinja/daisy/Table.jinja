{#def columns=[], rows=[], hx_target="", hx_url="", extra_class="" #}
{% autoescape true %}
{% set columns = columns if columns is defined else [] %}
{% set rows = rows if rows is defined else [] %}
{% set extra_class = extra_class if extra_class is defined else "" %}
<div class="overflow-x-auto {{ extra_class }}">
  <table class="table table-zebra w-full">
    <thead>
      <tr>
        {% for col in columns %}
        <th>{{ col.label }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        {% for col in columns %}
        <td>{{ row[col.key] }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endautoescape %}
