{#def content="", variant="neutral", size="normal", state="normal", href="", type="button", full_width=false, extra_class="", attrs={} #}
{% autoescape true %}
  {% set content = content if content is defined else "" %}
  {% set variant = variant if variant is defined else "neutral" %}
  {% set size = size if size is defined else "normal" %}
  {% set state = state if state is defined else "normal" %}
  {% set href = href if href is defined else "" %}
  {% set type = type if type is defined else "button" %}
  {% set full_width = full_width if full_width is defined else false %}
  {% set extra_class = extra_class if extra_class is defined else "" %}
  {% set attrs = attrs if attrs is defined else {} %}
  {{ cf_ui_validate("button", variant=variant, size=size, state=state, type=type) }}
  {%- set cf_tag = "a" if href else "button" -%}
  <{{ cf_tag }} class="button{% if variant == 'primary' %} primary{% elif variant == 'secondary' %} secondary{% elif variant == 'success' %} success{% elif variant == 'warning' %} warning{% elif variant == 'danger' %} alert{% elif variant == 'info' %} secondary{% endif %}{% if size == 'small' %} small{% elif size == 'large' %} large{% endif %}{% if state == 'disabled' %} disabled{% endif %}{% if full_width %} expanded{% endif %}{% if extra_class %} {{ extra_class }}{% endif %}"
  {%- if href %}{% if state == 'disabled' %} role="link" aria-disabled="true"{% else %} href="{{ href }}"{% endif %}
{%- else %} type="{{ type }}"{% if state == 'disabled' %} disabled{% endif %}{% endif %}{{ cf_ui_render_attrs("button", attrs) }}>{{ content }}</{{ cf_tag }}>
{% endautoescape %}
